#!/usr/bin/env bash
set -e

USER=team254
HOST=ec2.team254.com
APP=ftc-hours
SCRIPT_NAME=hours_server
BRANCH=ftc

echo "Deploying $APP from Git $BRANCH branch..."
echo
ssh $USER@$HOST "export RACK_ENV=production && cd /opt/sites/$APP && git checkout $BRANCH && git pull && bundle install && bundle exec rake db:migrate && sudo -n /usr/bin/systemctl restart $APP.service"
echo
echo "Deployed $APP."
