<%= erb :header %>

<div class="container">
  <% today = user_time_zone.now.to_date %>
  <div class="pull-right" style="margin-top: 20px; white-space: nowrap;">
    <% if @event.open_on?(today) %>
      <form action="/events/<%= @event.id %>/close" method="POST" style="display: inline;">
        <button type="submit" class="btn btn-warning">Close event</button>
      </form>
    <% end %>
    <a href="/events/<%= @event.id %>/delete" class="btn btn-danger">Delete event</a>
  </div>

  <h2><%= Rack::Utils.escape_html(@event.title) %></h2>
  <p><strong>Date:</strong> <%= @event.date.strftime("%B %-d, %Y") %></p>
  <p><strong>Status:</strong> <%= @event.status_on(today) %></p>
  <% if @event.open_on?(today) %>
    <p><strong>Check-in code:</strong> <span style="font-size: 1.5em;"><%= @event.check_in_code %></span></p>
  <% end %>
  <p><strong>Attendance:</strong> <%= @check_ins_by_student_id.length %> / <%= @students.length %></p>
  <p><strong>Excused:</strong> <%= @excused_student_ids.length %></p>

  <table class="table table-striped table-bordered table-condensed">
    <thead>
      <tr>
        <th>Student ID</th>
        <th>Name</th>
        <th>Status</th>
        <th>Checked In At</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% @students.each do |student| %>
        <% check_in = @check_ins_by_student_id[student.id] %>
        <% not_started = check_in.nil? && @event.date > today %>
        <% in_progress = check_in.nil? && @event.open_on?(today) %>
        <% excused = @excused_student_ids.include?(student.id) %>
        <% attendance_status = check_in ? "Present" : (excused ? "Excused" : (not_started ? "Not started" : (in_progress ? "In progress" : "Absent"))) %>
        <tr class="<%= "error" if attendance_status == "Absent" %>">
          <td><%= student.id %></td>
          <td><a href="/students/<%= student.id %>"><%= Rack::Utils.escape_html("#{student.first_name} #{student.last_name}") %></a></td>
          <td><%= attendance_status %></td>
          <td><%= check_in.checked_in_at.in_time_zone(USER_TIME_ZONE).strftime("%l:%M %p") rescue "" %></td>
          <td style="padding-top: 2px; padding-bottom: 2px; vertical-align: middle;">
            <% if excused %>
              <form action="/events/<%= @event.id %>/excusals/<%= student.id %>/delete" method="POST" style="margin: 0;">
                <button type="submit" class="btn btn-mini">Unexcuse</button>
              </form>
            <% elsif check_in.nil? %>
              <form action="/events/<%= @event.id %>/excusals" method="POST" style="margin: 0;">
                <input type="hidden" name="student_id" value="<%= student.id %>">
                <button type="submit" class="btn btn-mini">Excuse</button>
              </form>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<%= erb :footer %>
