<%= erb :header %>

<div class="container">
  <div class="pull-right" style="margin-top: 20px;">
    <a href="/events/report.csv" class="btn">Download CSV report</a>
  </div>
  <h2>Events</h2>

  <form action="/events" method="POST" class="form-inline" style="margin: 1.5rem 0 2rem;">
    <label for="event-title">Title</label>
    <input id="event-title" name="title" type="text" maxlength="255" required>
    <label for="event-date">Date</label>
    <input id="event-date" name="date" type="date" value="<%= user_time_zone.now.to_date %>" required>
    <button type="submit" class="btn btn-success">Schedule event</button>
  </form>

  <table class="table table-striped table-bordered table-condensed">
    <thead>
      <tr>
        <th>Date</th>
        <th>Event</th>
        <th>Status</th>
        <th>Checked In</th>
      </tr>
    </thead>
    <tbody>
      <% @events.each do |event| %>
        <tr>
          <td><%= event.date.strftime("%m/%d/%Y") %></td>
          <td><a href="/events/<%= event.id %>"><%= Rack::Utils.escape_html(event.title) %></a></td>
          <td><%= event.status_on(user_time_zone.now.to_date) %></td>
          <td><%= event.event_check_ins.length %> / <%= @student_count %></td>
        </tr>
      <% end %>
      <% if @events.empty? %>
        <tr><td colspan="4">No events have been scheduled.</td></tr>
      <% end %>
    </tbody>
  </table>

  <h2>Attendance</h2>
  <table class="table table-striped table-bordered table-condensed">
    <thead>
      <tr>
        <th>Name</th>
        <th>Events Attended</th>
        <th>Events Missed</th>
      </tr>
    </thead>
    <tbody>
      <% @attendance_students.each do |student| %>
        <% attended_count = @attended_event_counts_by_student_id[student.id] %>
        <tr class="<%= "error" if @reportable_event_count > 1 && attended_count.to_f / @reportable_event_count < 0.5 %>">
          <td><a href="/students/<%= student.id %>"><%= Rack::Utils.escape_html("#{student.first_name} #{student.last_name}") %></a></td>
          <td><%= attended_count %></td>
          <td><%= @reportable_event_count - attended_count %></td>
        </tr>
      <% end %>
      <% if @attendance_students.empty? %>
        <tr><td colspan="3">No students are on the Hours roster.</td></tr>
      <% end %>
    </tbody>
  </table>
</div>

<%= erb :footer %>
