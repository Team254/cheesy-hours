<%= erb :header %>

<div class="container">
  <h2>Danger Zone: Reindex Students</h2>

  <% if @reindex_result %>
    <div class="alert alert-success">
      Reindex complete: added <%= @reindex_result["added_count"] %>, updated <%= @reindex_result["updated_count"] %>,
      removed <%= @reindex_result["removed_count"] %>, and left <%= @reindex_result["unchanged_count"] %> unchanged.
    </div>
  <% end %>

  <h3>Preview</h3>
  <table class="table table-striped table-bordered table-condensed" style="max-width: 800px;">
    <thead>
      <tr>
        <th>Change</th>
        <th>Count</th>
      </tr>
    </thead>
    <tbody>
      <tr><td>Add</td><td><%= @reindex_preview[:added_students].length %></td></tr>
      <tr><td>Update names</td><td><%= @reindex_preview[:updated_students].length %></td></tr>
      <tr><td>Remove</td><td><%= @reindex_preview[:removed_students].length %></td></tr>
      <tr><td>Unchanged</td><td><%= @reindex_preview[:unchanged_count] %></td></tr>
    </tbody>
  </table>

  <% unless @reindex_preview[:added_students].empty? %>
    <h3>Students to Add</h3>
    <table class="table table-striped table-bordered table-condensed" style="max-width: 800px;">
      <thead><tr><th>ID</th><th>Name</th></tr></thead>
      <tbody>
        <% @reindex_preview[:added_students].each do |student| %>
          <tr>
            <td><%= student[:id] %></td>
            <td><%= Rack::Utils.escape_html("#{student[:first_name]} #{student[:last_name]}") %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>

  <% unless @reindex_preview[:updated_students].empty? %>
    <h3>Names to Update</h3>
    <table class="table table-striped table-bordered table-condensed" style="max-width: 800px;">
      <thead><tr><th>ID</th><th>Current</th><th>From Members</th></tr></thead>
      <tbody>
        <% @reindex_preview[:updated_students].each do |student| %>
          <tr>
            <td><%= student[:replacement][:id] %></td>
            <td><%= Rack::Utils.escape_html("#{student[:current][:first_name]} #{student[:current][:last_name]}") %></td>
            <td><%= Rack::Utils.escape_html("#{student[:replacement][:first_name]} #{student[:replacement][:last_name]}") %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>

  <% unless @reindex_preview[:removed_students].empty? %>
    <h3>Students to Remove</h3>
    <div class="alert alert-error" style="max-width: 800px; box-sizing: border-box;">
      Verify every removal. These students are not present in the Members database for this program.
    </div>
    <table class="table table-striped table-bordered table-condensed" style="max-width: 800px;">
      <thead><tr><th>ID</th><th>Name</th></tr></thead>
      <tbody>
        <% @reindex_preview[:removed_students].each do |student| %>
          <tr>
            <td><%= student[:id] %></td>
            <td><%= Rack::Utils.escape_html("#{student[:first_name]} #{student[:last_name]}") %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>

  <% if @reindex_preview[:blocked] %>
    <div class="alert alert-error">
      Reindexing is blocked because Members returned zero students. Verify the Members service and program configuration, then reload this page.
    </div>
  <% else %>
    <hr />
    <h3>Confirm Roster Synchronization</h3>
    <form action="/reindex_students" method="POST">
      <input type="hidden" name="reindex_token" value="<%= @reindex_token %>" />
      <label for="reindex-confirmation">Type <strong>"I want to reindex students."</strong> to continue</label>
      <input
        id="reindex-confirmation"
        type="text"
        name="confirmation"
        autocomplete="off"
        required
      />
      <div>
        <button
          type="submit"
          class="btn btn-danger"
          onclick="return confirm('Apply exactly the previewed student roster changes?');"
        >Reindex Students</button>
      </div>
    </form>
  <% end %>
</div>

<%= erb :footer %>
