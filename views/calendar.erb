<%= erb :header %>
<% range_start = @semester_start.strftime("%Y-%m-%d") %>
<% today = user_time_zone.now.to_date %>
<% end_of_current_week = today + ((7 - today.wday) % 7) %>
<% calendar_end = [@semester_end, end_of_current_week].min %>
<% range_end = calendar_end.strftime("%Y-%m-%d") %>
<% semester_name = @semester.capitalize %>
<% hide_optional = @hide_optional ? 1 : 0 %>
<% DB.fetch "SET sql_mode=(SELECT REPLACE(@@sql_mode,'ONLY_FULL_GROUP_BY',''));" do end %>
<% student_info_rows = DB.fetch(CALENDAR_STUDENT_INFO_RANGE_QUERY, range_start, range_end, hide_optional).all %>
<% build_days = DB.fetch(BUILD_DAYS_RANGE_QUERY, range_start, range_end, hide_optional).all %>
<% build_info_by_date_and_student = DB.fetch(CALENDAR_BUILD_INFO_RANGE_QUERY, range_start, range_end, hide_optional).all.each_with_object({}) do |row, rows| %>
   <% rows[[row[:build_date], row[:student_id]]] = row %>
<% end %>
<div class="container container-wide">
   <div style="display: flex; align-items: flex-start; flex-direction: column; gap: 0.5rem">
   <h2 style="margin-bottom: 0;">Calendar</h2>
   <form action="/calendar" method="get" style="display: inline-flex; flex-direction: column; align-items: flex-start; gap: 0.35rem;">
      <label for="semester-select" style="margin: 0;">Semester</label>
      <select id="semester-select" name="semester" style="margin: 0;">
         <option value="fall" <%= "selected" if @semester == "fall" %>>Fall (Aug-Dec)</option>
         <option value="spring" <%= "selected" if @semester == "spring" %>>Spring (Jan-May)</option>
         <option value="summer" <%= "selected" if @semester == "summer" %>>Summer (Jun-Jul)</option>
      </select>
      <label for="semester-year" style="margin: 0;">Year</label>
      <input id="semester-year" name="year" type="number" value="<%= @semester_year %>" min="2000" max="2100" style="width: 6rem; margin: 0;" />
      <label style="margin: 0;">
         <input type="checkbox" name="hide_optional" value="1" <%= "checked" if @hide_optional %> />
         Hide optional builds
      </label>
      <button type="submit" class="btn btn-small">Apply</button>
      <small>Range: <%= semester_name %> <%= @semester_year %> (<%= @semester_start.strftime("%b %-d") %> - <%= calendar_end.strftime("%b %-d") %>)</small>
   </form>
   <details class="" style="margin-top: -1.0rem; margin-bottom: 0.35rem;">
      <summary style="list-style: none">Legend</summary>
   </details>
   <table style="border: 1px solid #000; height: 38px; border-left: none; border-top-right-radius: 4px; border-bottom-right-radius: 4px;">
      <thead>
         <tr>
            <th style="width:70px; height:34px; text-align: center; background-color: var(--missing-color); color: White">Absent</th>
            <th style="width:70px; height:34px; text-align: center; background-color: var(--present-color); color: White">Present</th>
            <th style="width:70px; height:34px; text-align: center; background-color: var(--excused-color)">Optional</th>
            <th class="stripe-bg" style="width:70px; height:34px; --color-a: var(--excused-color); --color-b: var(--partial-color); text-align: center; border-top-right-radius: 4px; border-bottom-right-radius: 4px;">Excused</th>
            <th style="width:70px; height:34px; text-align: center; background-color: var(--scheduled-color); color: White">Scheduled</th>
         </tr>
      </thead>
   </table>
   </div>
      <div class="cheesy-row" style="clear: right">
        <div class="column2">
         <div id="calendar-header-sticky">
            <div id="calendar-header-scroll">
               <table style="table-layout: fixed; margin-bottom: 0px" class="table table-striped table-bordered table-condensed calendar-date-table" id="calendar-date-header">
                  <thead>
                     <tr>
                        <% build_days.each do |build_date| %>
                              <th style="width:60px; height:45px; padding-left: 0; padding-right: 0; text-align: center" title="<%= build_date[:build_date].strftime("%A, %B %-d, %Y") %>">
                                 <%= build_date[:build_date].strftime("%m/%d") %>
                                 <% if build_date[:starts_at] && build_date[:ends_at] %>
                                    <br><small style="font-size: 0.65em; line-height: 1; color: var(--scheduled-color);"><%= build_date[:starts_at].in_time_zone(USER_TIME_ZONE).strftime("%-l %p") %>–<%= build_date[:ends_at].in_time_zone(USER_TIME_ZONE).strftime("%-l %p") %></small>
                                 <% end %>
                                 <% if @user.has_permission?("HOURS_EDIT") %>
                                    <br/>
                                    <a href="/build_schedule?date=<%= build_date[:build_date] %>&optional=<%= build_date[:optional] %>" class="visible-if-parent-hover"><small style="font-size: 0.65em; padding: 0px 8px;">edit build</small></a>
                                    <% if build_date[:optional] == 1 %>
                                       <br/>
                                       <a href="/delete_optional/<%=build_date[:build_date]%>"><small style="font-size: 0.65em; padding: 0px 8px;">mark required</small></a>
                                    <% else %>
                                       <br/>
                                       <a href="/schedule_optional?date=<%=build_date[:build_date]%>" class="visible-if-parent-hover"><small style="font-size: 0.65em; padding: 0px 8px;">mark optional</small></a>
                                    <% end %>
                                 <% end %>
                                 <% if @user.has_permission?("DATABASE_ADMIN") %>
                                    <br/>
                                    <a href="/build_days/<%=build_date[:build_date]%>/delete" class="visible-if-parent-hover"><small style="font-size: 0.65em; padding: 0px 8px;">delete day</small></a>
                                 <% end %>
                              </th>
                        <% end %>
                     </tr>
                  </thead>
               </table>
            </div>
         </div>
         <div id="calendar-grid-scroll" style="padding-bottom: 64px;">
            <table style="table-layout: fixed;" class="table table-striped table-bordered table-condensed column-based" id="color-grid">
               <% build_days.each do |build_day| %>
                  <tr>
                  <% student_info_rows.each do |student_info| %>
                   <% row = build_info_by_date_and_student[[build_day[:build_date], student_info[:student_id]]] %>
                   <% next if row.nil? %>
                   <% student_id = row[:student_id] %>
                   <% session_id = row[:session_id] rescue nil %>
                   <% build_date = row[:build_date] %>
                   <% attended = row[:attended] %>
                   <% finalized = row[:finalized] %>
                   <% required = row[:required] %>
                   <% excused = row[:excused] %>
                  <% if finalized == 0 %>
                     <td style="background-color: var(--scheduled-color); min-width:50px; height:30px;"></td>
                  <% elsif (attended == 1) %>
                     <td style="background-color: var(--present-color); min-width:50px; height:30px;">
                        <% if @user.has_permission?("HOURS_EDIT") || @user.has_permission?("HOURS_DELETE") %>
                        <div class="btn-group visible-if-parent-hover">
                           <a class="btn dropdown-toggle" data-toggle="dropdown" href="#">
                              <span class="caret"></span>
                           </a>
                           <ul class="dropdown-menu">
                              <% if @user.has_permission?("HOURS_EDIT") %>
                              <li><a href="/lab_sessions/<%=session_id%>/edit">Edit Lab Session</a></li>
                              <% end %>
                              <% if @user.has_permission?("HOURS_DELETE") %>
                              <li><a href="/lab_sessions/<%=session_id%>/delete" class="text-error">Delete Lab Session</a></li>
                              <% end %>
                           </ul>
                        </div>
                        <% end %>
                     </td>
                  <% elsif (excused == 1 && required == 1) %>
                     <td style="--color-a: var(--excused-color); --color-b: var(--partial-color); min-width:50px; height:30px;" class="stripe-bg">
                        <% if @user.has_permission?("HOURS_EDIT") %>
                        <div class="btn-group visible-if-parent-hover">
                           <a class="btn dropdown-toggle" data-toggle="dropdown" href="#">
                              <span class="caret"></span>
                           </a>
                           <ul class="dropdown-menu">
                              <li><a href="/students/<%=student_id%>/excusals/<%=build_date%>/delete">Unexcuse</a></li>
                           </ul>
                        </div>
                        <% end %>
                     </td>
                  <% elsif (!(required == 1)) %>
                     <td style="background-color: var(--excused-color); min-width:50px; height:30px;">
                        <% if @user.has_permission?("HOURS_EDIT") %>
                        <div class="btn-group visible-if-parent-hover">
                           <a class="btn dropdown-toggle" data-toggle="dropdown" href="#">
                              <span class="caret"></span>
                           </a>
                           <ul class="dropdown-menu">
                              <li><a href="/students/<%=student_id%>/new_lab_session?date=<%=build_date%>">Add Lab Session</a></li>
                           </ul>
                        </div>
                        <% end %>
                     </td>
                  <% else %>
                     <td style = "background-color: var(--missing-color); min-width:50px; height:30px;">
                        <% if @user.has_permission?("HOURS_EDIT") %>
                        <div class="btn-group visible-if-parent-hover">
                           <a class="btn dropdown-toggle" data-toggle="dropdown" href="#">
                              <span class="caret"></span>
                           </a>
                           <ul class="dropdown-menu">
                              <li><a href="/students/<%=student_id%>/new_lab_session?date=<%=build_date%>">Add Lab Session</a></li>
                              <li><a href="/students/<%=student_id%>/mark_excused?date=<%=build_date%>">Excuse Student</a></li>
                           </ul>
                        </div>
                        <% end %>
                     </td>
                  <% end %>
                  <% end %>
                  </tr>
               <% end %>
            </table>
         </div>
      </div>
      <div class="column1">
            <table style="table-layout: fixed;" class="table table-striped table-bordered table-condensed student-table">
              <thead>
                <tr>
                  <th style="width:65px; height:45px; text-align: center">Builds Attended</th>
                  <th style="width:80px; height:45px; text-align: center">Attendance Rate</th>
                  <th style="width:65px; height:45px; text-align: center">Student ID</th>
                  <th style="width:200px; height:45px; text-align: center">Name (Unexcused)</th>
                </tr>
              </thead>
              <tbody>
                <% student_info_rows.each do |row|
                  student = Student[row[:student_id]]
                  %>
                  <tr style="width: 410px">
                     <td style="width:65px; height:30px;"><%=row[:total_attended_count]%></td>
                     <td style ="width:80px; height: 30px"><%=(100 * row[:required_attended_count].to_f/row[:required_count]).to_i rescue "0"%>%</td>
                     <td style="width:65px; height:30px;"><%=student.id%> </td>
                     <td
                        style="width:200px; height:30px; white-space: nowrap;"
                        title="<%=student.first_name + " " + student.last_name%>"
                     ><a href="/students/<%= student.id %>"><%= student.first_name %> <%= student.last_name %></a>
                        <span title="Unexcused absences in range">(<%= row[:unexcused_count].to_i %>)</span></td>
                  </tr>
                <% end %>
              </tbody>
            </table>
            <div style="display: flex; gap: 1.5em">
               <% if @user.has_permission?("HOURS_VIEW_REPORT") %>
                  <h4><a href="/csv_attendance_report">Download CSV Report</a></h4>
               <% end %>
               <% if @user.has_permission?("HOURS_EDIT") %>
               <h4><a href="/optionalize_past_offdays">Optionalize Past Off-days</a></h4>
               <% end %>
            </div>
        </div>
</div>
<script>
    var $headerScroll = $('#calendar-header-scroll');
    var $gridScroll = $('#calendar-grid-scroll');
    var left = $gridScroll.width() * 2;
    $gridScroll.scrollLeft(left);
    $headerScroll.scrollLeft(left);

    var syncing = false;
    $gridScroll.on('scroll', function() {
        if (syncing) { return; }
        syncing = true;
        $headerScroll.scrollLeft($gridScroll.scrollLeft());
        syncing = false;
    });
    $headerScroll.on('scroll', function() {
        if (syncing) { return; }
        syncing = true;
        $gridScroll.scrollLeft($headerScroll.scrollLeft());
        syncing = false;
    });
    $('#color-grid').children().children('tr:nth-last-child(2)').children().children().children(".dropdown-menu").addClass("pull-right")
    $('#color-grid').children().children('tr:nth-last-child(1)').children().children().children(".dropdown-menu").addClass("pull-right")
</script>
<%= erb :footer %>
